{
  "name": "oh-my-sessions",
  "version": "0.1.0",
  "description": "oh-my-sessions — list local agent sessions (Grok, Qoder, Claude, …) with age, health, tags, and chat view",
  "type": "module",
  "bin": {
    "oh-my-sessions": "./dist/index.js",
    "oms": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "list": "tsx src/index.ts --list",
    "list:json": "tsx src/index.ts --json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "oh-my-sessions",
    "agent",
    "session",
    "tui",
    "grok",
    "qoder",
    "claude"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
