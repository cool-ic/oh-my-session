{
  "name": "oh-my-sessions",
  "version": "0.1.0",
  "description": "A local file manager for unfinished AI coding sessions across Qoder, Claude Code, and Grok.",
  "type": "module",
  "bin": {
    "oh-my-sessions": "dist/index.js",
    "oms": "dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "prepack": "npm run build",
    "list": "tsx src/index.ts --list",
    "list:json": "tsx src/index.ts --json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "oh-my-sessions",
    "agent",
    "session",
    "tui",
    "grok",
    "qoder",
    "claude"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "docs/images",
    "docs/README_zh-CN.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cool-ic/oh-my-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/cool-ic/oh-my-sessions/issues"
  },
  "homepage": "https://github.com/cool-ic/oh-my-sessions#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
