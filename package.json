{
  "name": "oh-my-session",
  "version": "0.1.2",
  "description": "A local file manager for unfinished AI coding sessions across Qoder, Claude Code, and Grok.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "oms": "dist/index.js",
    "oh-my-session": "dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "prepack": "npm run build",
    "list": "tsx src/index.ts --list",
    "list:json": "tsx src/index.ts --json",
    "shots": "bash scripts/screenshot.sh main && bash scripts/screenshot.sh chat && bash scripts/screenshot.sh retention",
    "shots:zh": "OMS_SHOT_LOCALE=zh bash scripts/screenshot.sh main && OMS_SHOT_LOCALE=zh bash scripts/screenshot.sh chat && OMS_SHOT_LOCALE=zh bash scripts/screenshot.sh retention"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "oh-my-session",
    "oh-my-session",
    "oms",
    "agent",
    "session",
    "tui",
    "cli",
    "grok",
    "qoder",
    "claude",
    "claude-code"
  ],
  "author": "cool-ic",
  "license": "MIT",
  "files": [
    "dist",
    "docs/images",
    "docs/README_zh-CN.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cool-ic/oh-my-session.git"
  },
  "bugs": {
    "url": "https://github.com/cool-ic/oh-my-session/issues"
  },
  "homepage": "https://github.com/cool-ic/oh-my-session#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
